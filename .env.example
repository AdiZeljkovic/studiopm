# Public site URL — used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project inquiry delivery (server side). Leave empty to keep the form in
# "not connected" mode: submissions are validated and accepted but not forwarded.
# When set, every valid submission is POSTed as JSON to this URL
# (Laravel API endpoint, Make/Zapier webhook, custom service, ...).
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# File uploads. "simulated" (default) keeps attachments client-side only.
# "api" sends files to /api/upload, which must be connected to storage first
# (see lib/project-inquiry/upload.ts and app/api/upload/route.ts).
NEXT_PUBLIC_UPLOAD_MODE=simulated
